# Recall.ai credentials
# Region-specific base URL — us-west-2, us-east-1, eu-central-1, or ap-northeast-1
RECALL_REGION=us-west-2
RECALL_API_KEY=your_recall_api_key_here

# Recall.ai webhook verification secret (from Developers > API Keys & Secrets)
RECALL_WEBHOOK_SECRET=your_webhook_verification_secret_here

# Server
PORT=3000

# Google Gemini API key (optional) — enables AI-powered meeting summaries.
# Without this, the server uses local keyword heuristics instead.
GEMINI_API_KEY=your_gemini_api_key_here
